<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.gsb_visite.ui.login.LoginFragment"
        android:label="@string/login_title">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.gsb_visite.ui.login.SignupFragment"
        android:label="Inscription" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.gsb_visite.ui.HomeFragment"
        android:label="Accueil">
        <action
            android:id="@+id/action_homeFragment_to_visiteurDetailsFragment"
            app:destination="@id/visiteurDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/visiteurDetailsFragment"
        android:name="com.example.gsb_visite.ui.visitor.VisiteurDetailsFragment"
        android:label="Mes informations">
        <action
            android:id="@+id/action_visiteurDetailsFragment_to_praticienDetailsFragment"
            app:destination="@id/praticienDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/praticienDetailsFragment"
        android:name="com.example.gsb_visite.ui.praticien.PraticienDetailsFragment"
        android:label="Informations praticien">
        <argument
            android:name="praticienId"
            app:argType="string" />
    </fragment>
</navigation>
